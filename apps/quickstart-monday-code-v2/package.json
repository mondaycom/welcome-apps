{
  "name": "quickstart-monday-code-v2",
  "version": "2.0.0",
  "description": "Modern monday-code quickstart app for testing integrations",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "NODE_ENV=production node dist/server.js",
    "dev": "npm run dev:stop && concurrently \"npm run dev:server\" \"npm run dev:expose\"",
    "dev:server": "NODE_TLS_REJECT_UNAUTHORIZED='0' NODE_ENV=development tsx watch --inspect=9229 ./src/server.ts",
    "dev:expose": "mapps tunnel:create -p 8080",
    "dev:stop": "kill-port 8080"
  },
  "author": "Maor Barazani",
  "license": "ISC",
  "dependencies": {
    "@mondaycom/apps-sdk": "^3.3.2",
    "axios": "^1.7.9",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.1",
    "monday-sdk-js": "^0.5.6",
    "mongoose": "^8.8.3"
  },
  "devDependencies": {
    "@mondaycom/apps-cli": "^4.9.3",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.11.0",
    "concurrently": "^8.2.2",
    "kill-port": "^2.0.1",
    "nodemon": "^3.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
